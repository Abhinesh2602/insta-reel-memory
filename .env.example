# Copy to .env and fill in. All are optional - the app degrades gracefully
# without them (search falls back to plain FTS5, transcription needs at
# least one of GROQ_API_KEY or a local Whisper endpoint).

# Groq's free Whisper API (recommended) - used by transcribe.py, ocr_posts.py,
# retry_errors.py for speech-to-text. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: override the Whisper model (default: whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3

# Fallback local Whisper-compatible endpoint if you don't have a Groq key
# (e.g. a local faster-whisper or whisper.cpp server). Only used when
# GROQ_API_KEY is unset.
WHISPER_URL=http://localhost:8082/v1/audio/transcriptions

# Optional: typesafe.ai (JEV) API key. Used for two optional "smart" features:
#   1. jev_rerank() in app.py - re-ranks search results by actual relevance
#      instead of keyword match alone
#   2. category classification in transcribe.py / recategorize.py
# Without this key, search still works (plain FTS5 ranking) and reels just
# won't get auto-categorized. See https://typesafe.ai
TYPESAFE_API_KEY=

# Optional: Apify token, only used by one fallback path in transcribe.py for
# pulling reel metadata via Apify instead of yt-dlp.
APIFY_API_TOKEN=
